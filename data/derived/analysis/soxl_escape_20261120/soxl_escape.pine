// SOXL 긴급탈출·바닥 (검증 실패) — 2026-11-20
// 연구: data/derived/analysis/soxl_escape_20261120/report.md
// SOXL 1분봉으로 10/15~11/04에 고르고 11/05~11/19에 확인했다. 확인 구간에서 두 신호 모두 무작위 시점보다 낫다는 근거를 얻지 못했다(이름의 '검증 실패').
//   탈출: 무작위 탈출 대비 고른 구간 +0.17%p · 확인 구간 +0.00%p · 이전 장세(8/4~10/14) +0.13%p. 확인 구간 최악 5% 평균 손실은 무작위보다 컸다(−11.0% 대 −7.9%).
//   바닥: 같은 하락 국면 대비 60분 뒤 수익 +2.60%p · +0.09%p · −1.29%p.
// 탈출은 항상 1분봉, 바닥은 항상 3분봉으로 계산한다(1분·3의 배수 분봉 차트에서 같은 자리). 신호는 체결 봉이 정규장(09:30~16:00 ET, 겨울 한국 23:30~06:00)일 때만 띄운다.
// 탈출선(주황 점)은 '거래량이 줄어드는 랠리' 상태일 때만 그린다. 이 선 아래에서 1분봉이 마감하면 탈출이다. 바닥 구역선(청록)은 오늘 고가 −4%.
//@version=6
indicator("SOXL 긴급탈출·바닥 (검증 실패)", shorttitle = "탈출·바닥", overlay = true)

int tfSec = timeframe.in_seconds()
if not timeframe.isminutes or (tfSec != 60 and tfSec % 180 != 0)
    runtime.error("1분 또는 3의 배수 분봉(3·6·9·15·30·45·60분…)에서 쓰세요")

const string NY = "America/New_York"

// ── 입력 (연구 기본값) ──────────────────────────────────
const string G1 = "탈출 (1분봉)"
emaLen = input.int(10, "탈출선 = EMA 길이", minval = 2, group = G1, display = display.none)
rallyN = input.int(60, "랠리: 최근 몇 봉 저점 기준", minval = 2, group = G1, display = display.none)
rallyP = input.float(1.5, "랠리: 그 저점보다 몇 % 위", minval = 0.1, step = 0.1, group = G1, display = display.none)
volF   = input.int(10, "거래량 짧은 평균 (봉)", minval = 2, group = G1, display = display.none)
volS   = input.int(40, "거래량 긴 평균 (봉)", minval = 3, group = G1, display = display.none)
volR   = input.float(0.7, "거래량 줄어듦: 짧은/긴 평균이 이 값 미만", minval = 0.1, step = 0.05, group = G1, display = display.none)

const string G2 = "바닥 (3분봉)"
zoneP  = input.float(4.0, "바닥 구역: 오늘 고가보다 몇 % 아래", minval = 0.5, step = 0.5, group = G2, display = display.none)
gateN  = input.int(40, "하락 상황: 최근 몇 봉 고가 기준", minval = 2, group = G2, display = display.none)
gateP  = input.float(3.0, "하락 상황: 그 고가보다 몇 % 아래", minval = 0.5, step = 0.5, group = G2, display = display.none)
gapMin = input.int(30, "바닥 신호 사이 최소 간격 (분)", minval = 0, group = G2, display = display.none)

// 체결 봉(이 봉이 끝난 시각에 시작하는 봉)이 정규장인지
regEnd(int tc) =>
    int m = hour(tc, NY) * 60 + minute(tc, NY)
    m >= 570 and m < 960

// ── 탈출: 1분봉 ─────────────────────────────────────────
// 직전 봉이 '랠리(최근 저점 +1.5% 이상) + 거래량 줄어듦(10/40 평균 < 0.7)'이고, 이번 봉 종가가 EMA10 아래로 교차하면 탈출.
exitCalc() =>
    float e     = ta.ema(close, emaLen)
    float lo    = ta.lowest(low, rallyN)
    float vr    = ta.sma(volume, volF) / ta.sma(volume, volS)   // and 밖에서 매 봉 계산(v6 and는 앞이 거짓이면 뒤를 건너뜀)
    bool  armed = close >= lo * (1 + rallyP / 100) and vr < volR
    bool  sig   = armed[1] and close < e and close[1] >= e[1] and regEnd(time_close)
    // close < e 는 close < e[1] 과 같은 조건이라, 봉 시작 때 고정된 e[1]을 선으로 그린다(이 봉 종가가 이 선 아래면 탈출)
    [sig, armed[1] and close[1] >= e[1] ? e[1] : na]

// ── 바닥: 3분봉 ─────────────────────────────────────────
// 하락 상황(최근 40봉 고가 −3% 이하)에서 종가가 '오늘(04:00 ET부터) 고가 −4%' 선 아래로 처음 들어가면 바닥. 같은 날 30분 안 재신호는 뺀다.
bottomCalc() =>
    bool newDay = na(time[1]) or dayofmonth(time, NY) != dayofmonth(time[1], NY)
    var float dayHi = na
    dayHi := newDay or na(dayHi) ? high : math.max(dayHi, high)
    float zoneLn = dayHi * (1 - zoneP / 100)
    bool  zone   = close <= zoneLn
    bool  entry  = zone and not zone[1]
    bool  gate   = close <= ta.highest(high, gateN) * (1 - gateP / 100)
    var int lastT = na
    bool  spaced = na(lastT) or dayofmonth(time_close, NY) != dayofmonth(lastT, NY) or time_close - lastT >= gapMin * 60000
    bool  sig    = entry and gate and regEnd(time_close) and spaced
    if sig
        lastT := time_close
    [sig, zoneLn, time]

// 1분·2분 차트: 완성된 직전 3분봉 값(새 3분봉의 첫 봉에서 한 번만 표시)
bottomPrev() =>
    [s, l, t] = bottomCalc()
    [s[1], l[1], t[1]]

bool   small = tfSec == 60
string htf   = small ? "3" : timeframe.period
string ltf3  = small ? timeframe.period : "3"

[eSigs, eLines]   = request.security_lower_tf(syminfo.tickerid, "1", exitCalc())
[bS, bL, bT]      = request.security(syminfo.tickerid, htf, bottomPrev(), lookahead = barmerge.lookahead_on)
[bSigs, bLns, bTs] = request.security_lower_tf(syminfo.tickerid, ltf3, bottomCalc())

// 끝난 하위 봉(배열의 마지막이 아닌 원소)은 바로 쓰고, 진행 중인 마지막 원소는 차트 봉이 확정될 때만 쓴다
int  nE = array.size(eSigs)
bool exitNow = false
for [i, s] in eSigs
    exitNow := exitNow or (s and (barstate.isconfirmed or i < nE - 1))
float exitLine = nE > 0 ? array.last(eLines) : na

bool newBin = bT != bT[1]
int  nB = array.size(bSigs)
bool anyBot = false
for [i, s] in bSigs
    anyBot := anyBot or (s and (barstate.isconfirmed or i < nB - 1))
bool  bottomNow = small ? (bS and newBin) : anyBot
float zoneLine  = small ? bL : (array.size(bLns) > 0 ? array.last(bLns) : na)

// ── 그리기 ──────────────────────────────────────────────
plot(exitLine, "탈출선", color = color.new(color.orange, 0), linewidth = 3, style = plot.style_circles, display = display.pane)
plot(zoneLine, "바닥 구역선", color = color.new(color.teal, 0), linewidth = 1, style = plot.style_stepline, display = display.pane)
plotshape(exitNow, "탈출", style = shape.labeldown, location = location.abovebar, color = color.red, text = "탈출", textcolor = color.white, size = size.small)
plotshape(bottomNow, "바닥", style = shape.labelup, location = location.belowbar, color = color.teal, text = "바닥", textcolor = color.white, size = size.small)
alertcondition(exitNow, "탈출", "SOXL 탈출 신호")
alertcondition(bottomNow, "바닥", "SOXL 바닥 신호")
