// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// 경고·대피·재매수 — 2026-11-24 (이전 이름 'SOXL 경고선·재매수선')
// 연구: data/derived/analysis/exit40_20261122/report.md (9종목: SOXL MU AMD ARM DELL INTC SNDK STX WDC, 2026 고르는·확인 구간 + 최근 분기)
// 대피·재매수(일봉): 일봉 EMA10·20 중 낮은 쪽이 대피선, 높은 쪽이 재매수선. 일봉 종가가 대피선 아래면 다음 정규장 시가에 대피,
//   재매수선 위면 다음 정규장 시가에 재매수(겨울 한국 23:30). 두 선 사이는 그대로. 9종목 중 가장 튼튼했다(2025 9종목 모두 시점 값 양수).
//   더 빠른 대피(일봉 EMA3·15, 40분봉 선, 5분봉 선)는 9종목 중앙값으로 성적이 떨어졌다(MU 2026: 느린 선 +185%, 40분 선 +76%, 보유 +107%).
// 경고(정규장 40분봉): 보유 중에 정규장 가격이 '전날 마지막 40분봉의 EMA100(약 10거래일)'에 처음 닿으면 경고. 한 달 3~4번.
//   경고 뒤 5거래일 안에 실제 대피가 나온 비율 60%(경고 없는 날 17%). 경고 뒤 5일 수익은 평균 +2.1%라 경고만으로 파는 건 손해였다.
// 대피·재매수 신호는 일봉 마감 뒤 첫 봉(연장 차트는 16:00 애프터 봉)에 뜨고, 표시는 실제 체결 봉(다음 정규장 첫 봉)에 찍는다.
//   대피 표시에 그 진입의 손익을 적는다. 오른쪽에 지금 상태를 띄운다.
//@version=6
indicator("경고·대피·재매수", shorttitle = "경고·대피", overlay = true, max_labels_count = 500)

// ── 입력 ──────────────────────────────────────────────
const string G1 = "대피·재매수 (일봉)"
baseTf   = input.timeframe("D", "기준 봉", group = G1, display = display.none)
lenA     = input.int(10, "이평선 1 (EMA 길이)", minval = 2, group = G1, display = display.none)
lenB     = input.int(20, "이평선 2 (EMA 길이)", minval = 2, group = G1, display = display.none)
bandPct  = input.float(0.0, "띠 % (대피선 = 낮은 선 −띠, 재매수선 = 높은 선 +띠)", minval = 0.0, step = 0.5, group = G1, display = display.none)
stopMode = input.string("종가 확인", "대피 방식", options = ["종가 확인", "닿으면"], group = G1, display = display.none) == "닿으면"
const string G2 = "경고 (정규장 40분봉)"
showWarn = input.bool(true, "경고 표시", group = G2, display = display.none)
warnLen  = input.int(100, "경고선 = 40분봉 EMA 길이 (100 = 약 10거래일)", minval = 10, group = G2, display = display.none)
showMarket = input.bool(true, "SOXX·VVIX 장중 경고와 신규 진입 대기 표시", group = "반도체 시장", display = display.none)
const string G3 = "내 진입"
showMine = input.bool(false, "내 진입 따라가기", group = G3, display = display.none)
myTime   = input.time(timestamp("2026-11-20T09:30:00-05:00"), "진입 시각", group = G3, display = display.none)
myPrice  = input.float(0.0, "진입가 (0이면 그 시각이 든 봉의 종가)", minval = 0.0, group = G3, display = display.none)

if timeframe.in_seconds() > timeframe.in_seconds(baseTf)
    runtime.error("차트 봉이 기준 봉보다 큽니다. 기준 봉 이하의 차트에서 쓰세요")

const string NY = "America/New_York"
string tReg = ticker.modify(syminfo.tickerid, session.regular)   // 정규장 자료로만 계산(차트의 조정 설정은 그대로)
string soxx = ticker.new("NASDAQ", "SOXX", session.regular)
const string VVIX = "CBOE:VVIX"

pct(float x) =>
    (x >= 0 ? "+" : "") + str.tostring(x * 100, "0.0") + "%"

// ── 일봉 상태(완성된 봉마다 한 번) ─────────────────────────
core() =>
    float ea = ta.ema(close, lenA)
    float eb = ta.ema(close, lenB)
    float w  = math.min(ea, eb) * (1 - bandPct / 100)    // 대피선
    float r  = math.max(ea, eb) * (1 + bandPct / 100)    // 재매수선
    float wPrev = w[1]
    var bool inPos = true
    bool before = inPos
    if inPos
        bool out = stopMode ? (not na(wPrev) and low <= wPrev) : close < w
        if out
            inPos := false
    else if close > r                                     // 한 봉에 한 번만 바뀐다
        inPos := true
    var int chgT = na                                     // 마지막으로 상태가 바뀐 봉의 끝 시각
    if inPos != before
        chgT := time_close
    [inPos, w, r, time, chgT]

corePair() =>
    [s, w, r, t, c] = core()
    [s, w, r, t, c, s[1], w[1], r[1], t[1], c[1], time_close]

[s0, w0, r0, t0, c0, s1, w1, r1, t1, c1, dEnd] = request.security(tReg, baseTf, corePair(), lookahead = barmerge.lookahead_on)
// 차트 봉이 받은 기준 봉의 마감 뒤에 시작하면 그 봉(이미 끝남) 값, 아니면 직전 봉 값.
// lookahead_on 은 봉 시작 시각으로 붙어서 [1]만 쓰면 애프터·프리장·09:20 봉이 그저께 값을 보인다. 끝난 봉만 쓰므로 미래 정보는 없다.
bool  baseDone = not na(dEnd) and time >= dEnd
bool  stDone   = baseDone ? s0 : s1
float wLine    = baseDone ? w0 : w1
float rLine    = baseDone ? r0 : r1
int   baseT    = baseDone ? t0 : t1
int   chgT     = baseDone ? c0 : c1

// ── 경고선: 오늘 하루 고정 = 전날 마지막 정규장 40분봉의 EMA ──────
warnCalc() =>
    float e = ta.ema(close, warnLen)
    var float today = na
    if session.isfirstbar_regular
        today := e[1]                                     // 정규장 자료라 직전 봉 = 전날 마지막 정규장 40분봉
    [today, e, time_close]

[wToday, wEma, wEnd] = request.security(tReg, "40", warnCalc(), lookahead = barmerge.lookahead_on)
// 받은 40분봉이 차트 봉 시작 전에 끝났으면(애프터·프리장·09:20 봉) 그 봉이 그날 마지막 정규장 봉이라 그 EMA가 다음 정규장 경고선
float warnLvl = not na(wEnd) and time >= wEnd ? wEma : wToday
float dayOpen = request.security(tReg, "D", open, lookahead = barmerge.lookahead_on)   // 오늘 정규장 시가(정규장 첫 봉부터 씀)

// ── 차트 봉의 시간 구분 ───────────────────────────────────
int  bs        = hour(time, NY) * 60 + minute(time, NY)
int  be        = hour(time_close, NY) * 60 + minute(time_close, NY)
bool newDay    = bar_index == 0 or dayofmonth(time, NY) != dayofmonth(time[1], NY)
bool regBar    = not timeframe.isintraday or session.ismarket             // 봉 시작이 정규장(일봉 이상은 늘 정규장 봉)
bool regTouch  = regBar or (bs < 570 and be > 570)                        // 정규장과 겹치는 봉(40분 연장 차트의 09:20~10:00 봉 포함)
bool execBar   = regBar and (newDay or not regBar[1])                     // 그날 첫 정규장 봉 = 종가 신호의 체결 봉

// 09:20~10:00 봉의 프리장 10분을 뺀 정규장 저가·첫 시가(정규장 5분봉으로 잰다, 연구는 정규장 1분봉만 본다)
string ltf = timeframe.in_seconds() > 300 ? "5" : timeframe.period
[oArr, lArr] = request.security_lower_tf(tReg, ltf, [open, low])
float lowR   = regBar ? low : array.size(lArr) > 0 ? array.min(lArr) : na     // 09:30 전(실시간)에는 na → 프리장 가격으로 경고·대피하지 않는다
float openR  = regBar ? open : array.size(oArr) > 0 ? array.first(oArr) : na

// SOXX 각 주기의 직전 확정선과 방향. 두 EMA 사이에서는 직전 방향을 유지한다.
priorBand() =>
    float fast = ta.ema(close, 10)
    float slow = ta.ema(close, 20)
    float floorPrice = bar_index >= 19 ? math.min(fast, slow) : na
    var int direction = na
    if close < floorPrice
        direction := -1
    else if not na(floorPrice) and close > math.max(fast, slow)
        direction := 1
    [floorPrice[1], direction[1]]

vvixCloses() =>
    float nextThreshold = ta.percentile_linear_interpolation(close, 63, 80)
    bool elevated = close >= nextThreshold[1]
    int nextWait = na(nextThreshold[2]) ? int(na) : (elevated or elevated[1] ? 1 : 0)
    [nextThreshold, nextWait, time_close, nextThreshold[1], nextWait[1], time_close[1]]

// VVIX 당일 봉은 SOXX 개장보다 늦게 들어올 수 있다. 두 후보 중 기준 시각까지 마감된 마지막 봉만 선택한다.
vvixAt(int cutoff) =>
    [level, waitState, ending, priorLevel, priorWait, priorEnd] = request.security(VVIX, "D", vvixCloses(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
    if ending <= cutoff
        [level, waitState, ending]
    else if priorEnd <= cutoff
        [priorLevel, priorWait, priorEnd]
    else
        [float(na), int(na), int(na)]

soxxSession() =>
    request.security(soxx, "D", [time, time_close, time[1]], lookahead = barmerge.lookahead_on)

// 각 시세의 1분봉에서 최초 접촉 시각을 보존한다. 큰 차트 봉 안에서 반등해도 경고가 남는다.
soxxWatch() =>
    [hourFloor, hourDir] = request.security(soxx, "60", priorBand(), lookahead = barmerge.lookahead_on)
    [dayFloor, dayDir] = request.security(soxx, "D", priorBand(), lookahead = barmerge.lookahead_on)
    [opening, ending, previousOpen] = soxxSession()
    [_, volWait, volClose] = vvixAt(opening)
    var int sectorDir = na
    if not na(hourDir) and hourDir == dayDir
        sectorDir := hourDir
    var int openingDir = na
    if session.isfirstbar_regular
        openingDir := sectorDir
    var int sectorHit = na
    if (na(sectorHit) or sectorHit < opening) and low < math.min(hourFloor, dayFloor)
        sectorHit := time
    // 이전 SOXX 세션의 VVIX 종가까지 들어왔는지 확인한다.
    [sectorHit, openingDir, sectorDir, volClose > previousOpen ? volWait : int(na), opening, ending]

vvixWatch() =>
    [opening, ending, previousOpen] = soxxSession()
    [threshold, _, volClose] = vvixAt(opening)
    var int volHit = na
    var int lastQuote = na
    if time >= opening and time < ending
        lastQuote := time
        if (na(volHit) or volHit < opening) and volClose > previousOpen and high >= threshold
            volHit := time
    [volHit, lastQuote, opening, ending]

[sectorHitTime, openSectorDir, sectorDirNow, volWaitToday, marketOpen, marketEnd] = request.security(soxx, "1", soxxWatch(), lookahead = barmerge.lookahead_off)
[volHitTime, volQuoteTime, volOpen, volEnd] = request.security(VVIX, "1", vvixWatch(), lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
[_, latestVolWait, latestVolClose] = vvixAt(barstate.isrealtime ? timenow : time_close)
bool marketBar = showMarket and not na(marketOpen) and time < marketEnd and time_close > marketOpen
newHit(int stamp, int opening, int ending) =>
    showMarket and bar_index > 0 and time < ending and time_close > opening and stamp >= opening and (na(stamp[1]) or stamp != stamp[1])
bool sectorWarning = newHit(sectorHitTime, marketOpen, marketEnd)
bool volWarning = newHit(volHitTime, volOpen, volEnd)

entryCaution(int direction, int volWait) =>
    direction == -1 ? (volWait == 1 ? "SOXX 약세 · VVIX 경계" : "SOXX 약세") : (volWait == 1 ? "VVIX 경계" : "")

string openingCaution = marketBar ? entryCaution(openSectorDir, volWaitToday) : ""
bool marketUnknown = showMarket and (not marketBar or na(openSectorDir) or na(volWaitToday))
string entryLabel = openingCaution != "" ? "종목 재매수 신호\n신규 진입 대기 · " + openingCaution : (marketUnknown ? "종목 재매수 신호\n시장 자료 미확인" : "재매수")
color entryColor = openingCaution != "" ? color.orange : (marketUnknown ? color.gray : color.green)

// ── '닿으면' 방식: 기준 봉 안에서 정규장 가격이 닿는 순간 대피 ──────────────
bool newBase  = baseT != baseT[1]
bool dayBase  = timeframe.in_seconds(baseTf) >= 86400
var bool stopped = false
if newBase
    stopped := false
bool touchNow = stopMode and stDone and not stopped and regTouch and not na(wLine) and not na(lowR) and lowR <= wLine
if touchNow
    stopped := true

bool holding = stDone and not stopped
bool sigOut  = bar_index > 0 and not holding and holding[1]
bool sigIn   = bar_index > 0 and holding and not holding[1]

// ── 체결과 표시(대피·재매수는 체결 봉에, 대피에 손익) ──────────────
var bool  pendIn  = false
var bool  pendOut = false
var float entryPx = na
bool didOut = false
if sigOut
    if touchNow
        if pendIn                                         // 재매수 대기 중 개장 직후 닿음: 연구는 시가에 산 뒤 같은 날 대피
            entryPx := regBar ? dayOpen : openR
            label.new(bar_index, low, entryLabel, style = label.style_label_up, color = entryColor, textcolor = color.white, size = size.small)
        float px = math.min(openR, wLine)
        label.new(bar_index, high, "대피" + (na(entryPx) ? "" : " " + pct(px / entryPx - 1)), style = label.style_label_down, color = color.red, textcolor = color.white, size = size.small)
        entryPx := na
        didOut := true
    else
        pendOut := true
    pendIn := false
if sigIn
    pendOut := false
    pendIn  := true
if execBar                                                // 대기 상태는 앞 봉에서 이미 확정돼 봉 안에서 바뀌지 않는다
    if pendOut
        label.new(bar_index, high, "대피" + (na(entryPx) or na(dayOpen) ? "" : " " + pct(dayOpen / entryPx - 1)), style = label.style_label_down, color = color.red, textcolor = color.white, size = size.small)
        entryPx := na
        pendOut := false
        didOut := true
    if pendIn
        entryPx := dayOpen
        label.new(bar_index, low, entryLabel, style = label.style_label_up, color = entryColor, textcolor = color.white, size = size.small)
        pendIn := false

// ── 경고: 보유 중 정규장 가격이 오늘 경고선에 처음 닿을 때 ────────
var bool warnedToday = false
if newDay
    warnedToday := false
bool warnNow = showWarn and holding and not pendOut and regTouch and not na(warnLvl) and not na(lowR) and lowR <= warnLvl and not warnedToday
if warnNow
    warnedToday := true

// ── 내 진입 따라가기 ──────────────────────────────────────
var bool  myOn   = false
var bool  myDone = false
var float myPx   = na
bool myBar = showMine and not myOn and time_close > myTime and (bar_index == 0 ? time <= myTime : time_close[1] <= myTime)   // 진입 시각이 든 봉
if myBar
    myOn := true
    myPx := myPrice > 0 ? myPrice : close
    label.new(bar_index, low, holding ? "내 진입" : "내 진입 (대피 구간)", style = label.style_label_up, color = color.blue, textcolor = color.white, size = size.small)
    myDone := not holding
if showMine and myOn and not myDone and didOut
    label.new(bar_index, high, "내 진입 대피 " + pct((touchNow ? math.min(openR, wLine) : dayOpen) / myPx - 1), style = label.style_label_down, color = color.navy, textcolor = color.white, size = size.small)
    myDone := true

// ── 그리기 ──────────────────────────────────────────────
color cW = holding ? color.new(color.red, 0) : color.new(color.red, 75)
color cR = holding ? color.new(color.green, 75) : color.new(color.green, 0)
plot(wLine, "대피선", color = cW, linewidth = 2, style = plot.style_stepline, display = display.pane)
plot(rLine, "재매수선", color = cR, linewidth = 2, style = plot.style_stepline, display = display.pane)
plot(showWarn and holding ? warnLvl : na, "경고선", color = color.new(color.orange, 0), linewidth = 1, style = plot.style_linebr, display = display.pane)
plot(showMine and myOn and not myDone ? myPx : na, "내 진입가", color = color.new(color.blue, 30), linewidth = 1, style = plot.style_linebr, display = display.pane)
plotshape(warnNow, "경고", style = shape.labeldown, location = location.abovebar, color = color.orange, text = "경고", textcolor = color.white, size = size.tiny)
plotshape(sectorWarning or volWarning, "장중 시장 경고", style = shape.labeldown, location = location.top, color = color.purple, text = "시장 경고", textcolor = color.white, size = size.tiny)
alertcondition(warnNow, "경고", "경고선 닿음 — 대피 주의")
alertcondition(sigOut, "대피", "대피 신호 — 다음 정규장 시가 대피(닿으면 방식은 지금)")
alertcondition(sigIn, "재매수", "종목 재매수 신호 · 다음 정규장 시가 기준, 차트의 시장 경고와 신규 진입 대기 표시 확인")

// 서버 알림 '모든 alert() 함수 호출'. 같은 차트 봉 안에서 뒤늦게 켜진 다른 원인도 한 번 전달한다.
varip int sentSector = 0
varip int sentVol = 0
varip int listeningFrom = timenow - timenow % 60000   // 알림을 만든 봉에서 앞서 발생한 경고의 재전송 방지
bool sendSector = sectorWarning and sectorHitTime >= listeningFrom and sectorHitTime != sentSector and timenow < marketEnd
bool sendVol = volWarning and volHitTime >= listeningFrom and volHitTime != sentVol and timenow < volEnd
if barstate.isrealtime and (sendSector or sendVol)
    string reason = (sendSector ? "SOXX가 60분·일봉 EMA 하단을 모두 이탈" : "") + (sendSector and sendVol ? " / " : "") + (sendVol ? "VVIX가 직전 63거래일 상위 20% 기준에 도달" : "")
    alert("정규장 시장 경고 · " + reason + " · 신규 진입 점검", alert.freq_all)
    if sendSector
        sentSector := sectorHitTime
    if sendVol
        sentVol := volHitTime

// ── 지금 상태(마지막 봉 오른쪽) ───────────────────────────────
var label st = na
if barstate.islast
    label.delete(st)
    string txt = "기준 봉 이력 부족 — 더 큰 봉 차트에서 확인"
    if not na(wLine)
        string when = na(chgT) ? "" : dayBase ? str.format_time(chgT, "M/d", NY) + (not holding and stopMode ? " 닿음" : " 종가 신호") : str.format_time(chgT, "M/d HH:mm", "Asia/Seoul") + " 신호"
        if pendOut
            txt := "대피 대기 — 다음 정규장 시가"
        else if pendIn
            txt := "재매수 대기 — 다음 정규장 시가"
        else if holding
            txt := "보유 중" + (when == "" ? "" : " (" + when + ")") + "\n대피선 " + str.tostring(wLine, format.mintick) + " (" + pct(wLine / close - 1) + ")" + (showWarn and not na(warnLvl) ? "\n경고선 " + str.tostring(warnLvl, format.mintick) + " (" + pct(warnLvl / close - 1) + ")" : "")
        else
            txt := "대피 중" + (stopped ? " (지금 닿음)" : when == "" ? "" : " (" + when + ")") + "\n재매수선 " + str.tostring(rLine, format.mintick) + " (" + pct(rLine / close - 1) + ")"
    if showMarket and not na(marketOpen)
        string caution = entryCaution(sectorDirNow, volWaitToday)
        if caution != ""
            txt += "\n" + str.format_time(marketOpen, "M/d", NY) + " 정규장 신규 진입 대기 · " + caution
        if sectorHitTime >= marketOpen or volHitTime >= marketOpen
            txt += "\n" + str.format_time(marketOpen, "M/d", NY) + " 장중 경고" + (sectorHitTime >= marketOpen ? " · SOXX" : "") + (volHitTime >= marketOpen ? " · VVIX" : "")
        if marketBar and (na(volQuoteTime) or volQuoteTime < marketOpen)
            txt += "\nVVIX 정규장 시세 대기"
        if marketBar and na(volWaitToday) and not na(latestVolWait)
            txt += "\n개장 기준 VVIX 종가 확인 대기"
    if showMarket
        if na(latestVolWait)
            txt += "\nVVIX 종가 자료 미확인"
        else
            txt += "\nVVIX " + str.format_time(latestVolClose, "M/d", NY) + " 종가 · " + (latestVolWait == 1 ? "경계" : "대기 해제")
    st := label.new(bar_index + 3, close, txt, xloc = xloc.bar_index, style = label.style_label_left, color = na(wLine) ? color.gray : holding and not pendOut ? color.new(color.green, 15) : color.new(color.red, 15), textcolor = color.white, size = size.normal)
