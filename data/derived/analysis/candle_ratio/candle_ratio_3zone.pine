// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// 양봉 비율 3단계 — 2026-10-25 (연구: data/derived/analysis/candle_ratio, 계산은 code/zones3.py와 같다. 재현 code/z3pine_replica.py)
// 원안 상태 st(연구의 s): 최근 N봉(지금 봉 포함) 양봉 개수 비율 p로 따라가기. 현금이고 p > 매수 문턱이면 보유, 보유이고 p < 매도 문턱이면 현금. 도지는 세지 않는다.
// 추세 판정(하나 고름)이 추세이면 st 보유 → 상승 추세(초록), st 현금 → 하락 추세(빨강). 추세가 아니면 애매(회색).
//   효율 비율: |C − C[K]| ÷ 최근 K봉 |ΔC| 합 ≥ 문턱 (기본 K 20, 0.3)
//   뒤집힘 수: 최근 K봉 안에서 st가 바뀐 횟수 < m (K 40, m 3)
//   비율 뚜렷함: 최근 N2봉 개수 비율 p2가 |p2 − 0.5| ≥ δ (N2 20, δ 0.1)
//   ADX: 와일더 ADX(DI·평활 같은 기간 14) ≥ 20. 트레이딩뷰 기본 ADX(14, 14)와 같은 식이다(참 범위 평균이 0인 봉만 다르다).
//   큰 봉 일치: 같은 비율 상태(N·문턱 같음)를 정규장 일봉으로 계산해, 마지막 완성 일봉 상태가 st와 같으면 추세.
// 구간은 봉 마감 때 정해지고 그 봉 배경에 칠한다. 진행 중인 봉은 직전 봉 구간을 보여 주다가 마감 때 바뀐다(다시 그리기 없음).
// 큰 봉 일치는 16:00 ET에 끝나는 봉부터 그날 일봉을 쓴다(연구와 같음). 실시간에서 그 봉은 마감 순간의 일봉 값을 쓰므로 장 마감 동시호가가 일봉 색을 바꾸면 새로고침 뒤 그 봉 하나가 달라질 수 있다.
// 차트 맨 앞 봉은 계산 시작점이 연구와 달라 값이 다를 수 있다. 시작을 1·5·10일 늦춰 본 시험(MU·BE·NBIS)에서 상태는 11봉, ADX 구간은 95봉, ADX 값은 약 290봉(40분봉 12거래일) 안에 같아졌다.
// 관찰용 표시다. 매수·매도 신호가 아니다. 이 3단계가 성적을 높이는지는 BRIEF2.md 판정을 따른다.
//@version=6
indicator("양봉 비율 3단계", shorttitle = "양봉3단계", overlay = false, precision = 2, max_bars_back = 500)

// ── 입력 ──────────────────────────────────────────────
n      = input.int(10, "봉 개수 N", minval = 1, maxval = 500, display = display.none)
b      = input.float(0.5, "매수 문턱", minval = 0.0, maxval = 1.0, step = 0.05, display = display.none)
s      = input.float(0.5, "매도 문턱", minval = 0.0, maxval = 1.0, step = 0.05, display = display.none)
mode   = input.string("효율 비율", "추세 판정", options = ["효율 비율", "뒤집힘 수", "비율 뚜렷함", "ADX", "큰 봉 일치"], display = display.none)
erLen  = input.int(20, "효율 비율: 기간 K", minval = 1, maxval = 400, display = display.none)
erTh   = input.float(0.3, "효율 비율: 문턱", minval = 0.0, maxval = 1.0, step = 0.05, display = display.none)
flLen  = input.int(40, "뒤집힘 수: 기간 K", minval = 1, maxval = 400, display = display.none)
flMax  = input.int(3, "뒤집힘 수: m (미만이면 추세)", minval = 1, display = display.none)
exN    = input.int(20, "비율 뚜렷함: 봉 개수 N2", minval = 1, maxval = 500, display = display.none)
exD    = input.float(0.1, "비율 뚜렷함: |p2 − 0.5| 이상", minval = 0.0, maxval = 0.5, step = 0.05, display = display.none)
adxLen = input.int(14, "ADX: 기간", minval = 1, maxval = 200, display = display.none)
adxTh  = input.float(20, "ADX: 문턱", minval = 0, step = 1, display = display.none)
cUp    = input.color(#089981, "상승 추세 (양봉 초록)", display = display.none)
cDn    = input.color(#F23645, "하락 추세 (음봉 빨강)", display = display.none)
cMid   = input.color(#9E9E9E, "애매", display = display.none)
bgT    = input.int(80, "배경 투명도", minval = 0, maxval = 100, display = display.none)

// ── 비율 p, p2 (봉 마감 때 안다) ──────────────────────────
float up  = close > open ? 1.0 : 0.0
float dn  = close < open ? 1.0 : 0.0
float sU  = math.sum(up, n)
float sD  = math.sum(up + dn, n)
float p   = bar_index < n - 1 or na(sU) or na(sD) ? na : sD > 1e-12 ? sU / sD : 0.5
float sU2 = math.sum(up, exN)
float sD2 = math.sum(up + dn, exN)
float p2  = bar_index < exN - 1 or na(sU2) or na(sD2) ? na : sD2 > 1e-12 ? sU2 / sD2 : 0.5

// ── 원안 상태 기계 (봉 마감에만 판단) ──────────────────────
var int st = 0                  // 0 현금, 1 보유
if barstate.isconfirmed and not na(p)
    if st == 0
        if p > b
            st := 1
    else
        if p < s
            st := 0

// ── 추세 판정 재료 (모든 봉에서 계산) ──────────────────────
// 효율 비율: 오래된 봉부터 더한다(연구 코드와 같은 순서라 값이 비트 단위로 같다)
float erPath = 0.0
if bar_index >= erLen
    for i = 0 to erLen - 1
        int back = erLen - 1 - i
        erPath += math.abs(close[back] - close[back + 1])
float er = bar_index < erLen ? na : erPath > 0 ? math.abs(close - close[erLen]) / erPath : 0.0

// 뒤집힘 수: 최근 K봉에서 st가 직전 봉과 달라진 횟수
int   chg   = st != nz(st[1], st) ? 1 : 0
float flSum = math.sum(chg, flLen)     // 삼항식 밖에서 모든 봉에 부른다
float flN   = bar_index < flLen ? na : flSum

// ADX (와일더): 처음 K봉은 합으로 시작해 와일더 평활, DX는 처음 K개 평균으로 시작
var float aTr  = 0.0
var float aP   = 0.0
var float aN   = 0.0
var float aDx  = 0.0
var int   aCnt = 0
float adxV = na
if bar_index >= 1
    float hUp = high - high[1]
    float lDn = low[1] - low
    float pdm = hUp > lDn and hUp > 0 ? hUp : 0.0
    float ndm = lDn > hUp and lDn > 0 ? lDn : 0.0
    float tr1 = math.max(high - low, math.abs(high - close[1]), math.abs(low - close[1]))
    if bar_index <= adxLen
        aTr += tr1
        aP  += pdm
        aN  += ndm
    else
        aTr := aTr - aTr / adxLen + tr1
        aP  := aP - aP / adxLen + pdm
        aN  := aN - aN / adxLen + ndm
    if bar_index >= adxLen
        float pdi = aTr > 0 ? 100 * aP / aTr : 0.0
        float ndi = aTr > 0 ? 100 * aN / aTr : 0.0
        float dx  = pdi + ndi > 0 ? 100 * math.abs(pdi - ndi) / (pdi + ndi) : 0.0
        aCnt += 1
        if aCnt <= adxLen
            aDx += dx
            if aCnt == adxLen
                aDx  := aDx / adxLen
                adxV := aDx
        else
            aDx  := (aDx * (adxLen - 1) + dx) / adxLen
            adxV := aDx

// 큰 봉 일치: 정규장 일봉에서 같은 비율 상태를 돌린다
dailyState(int len, float bTh, float sTh) =>
    float u  = close > open ? 1.0 : 0.0
    float d  = close < open ? 1.0 : 0.0
    float a  = math.sum(u, len)
    float q  = math.sum(u + d, len)
    float pd = bar_index < len - 1 or na(a) or na(q) ? na : q > 1e-12 ? a / q : 0.5
    var int ds = 0
    if not na(pd)
        if ds == 0
            if pd > bTh
                ds := 1
        else
            if pd < sTh
                ds := 0
    [ds, ds[1], time_close]

// 현재 봉과 직전 봉 값을 함께 받고, 봉 마감 시각으로 마지막 완성 일봉을 고른다(trend_5zone.pine 방식).
// trend_5zone은 time_close > 일봉 마감이지만 여기는 >=다: 16:00 ET에 끝나는 봉(연장 40분봉 15:20 봉)이 그날 일봉을 쓴다(zones3.py와 같음).
[dC, dP, dClose] = request.security(ticker.modify(syminfo.tickerid, session.regular), "D", dailyState(n, b, s), lookahead = barmerge.lookahead_off)
bool dDone  = na(dClose) or (timenow >= dClose and (not timeframe.isintraday or na(time_close) or time_close >= dClose))
int  dState = dDone ? dC : dP

// ── 구간 (봉 마감에만 정한다) ─────────────────────────────
bool trend = switch mode
    "효율 비율"   => not na(er) and er >= erTh
    "뒤집힘 수"   => not na(flN) and flN < flMax
    "비율 뚜렷함" => not na(p2) and math.abs(p2 - 0.5) >= exD - 1e-12
    "ADX"         => not na(adxV) and adxV >= adxTh
    => not na(dState) and dState == st

var int zone = 0                // 1 상승 추세, -1 하락 추세, 0 애매
if barstate.isconfirmed
    zone := trend ? (st == 1 ? 1 : -1) : 0

// ── 표시 (이 창에만 그린다) ───────────────────────────────
color zc = zone == 1 ? cUp : zone == -1 ? cDn : cMid
bgcolor(color.new(zc, bgT), title = "구간")
plot(p, "비율", color = #1565C0, linewidth = 2, display = display.pane)
hline(0.5, "0.5", color = color.gray, linestyle = hline.style_dotted)

// ── 알림 (봉 마감에 구간이 바뀔 때) ───────────────────────
bool zChg = barstate.isconfirmed and not na(zone[1]) and zone != zone[1]
alertcondition(zChg and zone == 1,  "상승 추세 진입", "{{ticker}} 양봉 비율 3단계: 상승 추세")
alertcondition(zChg and zone == -1, "하락 추세 진입", "{{ticker}} 양봉 비율 3단계: 하락 추세")
alertcondition(zChg and zone == 0,  "애매 진입",     "{{ticker}} 양봉 비율 3단계: 애매")
