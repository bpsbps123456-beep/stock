// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// 원본: © BackQuant "Kalman Adjusted Average True Range" → 5단계 구간으로 개선 (2026-09-28)
// 기본값은 야간 데스크 7종목·2026년 모의매매로 고른 값: 240분 정규장, 평활 21, RMS 50, a 0.75, b 1.75
//@version=6
indicator("Kalman 5단계 구간", shorttitle = "Kalman 5Zone", overlay = true)

// ── 계산 ──────────────────────────────────────────────
const string G1 = "계산"
calcTf      = input.timeframe("240", "계산 시간봉", group = G1, tooltip = "차트를 40분·3분 등 어느 시간봉으로 봐도 구간은 이 시간봉의 완성봉으로 계산합니다. 비우면 차트 시간봉.")
regularOnly = input.bool(true, "정규장 봉으로 계산", group = G1, tooltip = "켜면 차트에 연장시간이 보여도 구간은 정규장(09:30~16:00) 봉으로 계산합니다.")
smoothLen   = input.int(21, "칼만 평활 길이 (EMA 환산 봉 수)", minval = 2, group = G1, tooltip = "240분 정규장 21봉 ≈ 10거래일. Process Noise는 이 값으로 자동 계산합니다(21 → 0.0273).")
measNoise   = input.float(3.0, "Measurement Noise", minval = 0.001, group = G1)
widthLen    = input.int(50, "폭 계산 봉 수 (가격-칼만선 RMS)", minval = 5, group = G1)
multA       = input.float(0.75, "매수·매도 라인 배수 a", minval = 0.05, step = 0.05, group = G1)
multB       = input.float(1.75, "과매수·패닉셀 라인 배수 b", minval = 0.1, step = 0.05, group = G1)

// ── 표시 ──────────────────────────────────────────────
const string G2 = "표시"
showFill  = input.bool(true, "구간 색 채우기", group = G2)
showMarks = input.bool(true, "구간 진입 표시", group = G2)
showTable = input.bool(true, "현재 구간·라인 가격 표", group = G2)
paintBars = input.bool(false, "캔들을 구간 색으로", group = G2)
cOver  = input.color(#FFB300, "과매수 (절반 익절)", group = G2)
cBuy   = input.color(#00C853, "매수", group = G2)
cMid   = input.color(#9E9E9E, "평범", group = G2)
cSell  = input.color(#FF5252, "매도 (손절)", group = G2)
cPanic = input.color(#2979FF, "패닉셀 (매수 기회)", group = G2)

// 원본 칼만 필터는 N개 상태가 모두 같은 값이라 한 개로 줄였다. 정상상태 이득 = 2/(평활+1)이 되게 Process Noise를 맞춘다.
gSteady   = 2.0 / (smoothLen + 1.0)
sRatio    = gSteady / (1.0 - gSteady)
procNoise = measNoise * sRatio * sRatio / (1.0 + sRatio)

calc() =>
    var float x = na
    var float p = 1.0
    if na(x)
        x := close
        p := 1.0
    float pp = p + procNoise
    float kg = pp / (pp + measNoise)
    x := x + kg * (close - x)
    p := (1.0 - kg) * pp
    float res = close - x
    float w = math.sqrt(ta.sma(res * res, widthLen))
    [x, w, close]

// 현재 봉과 직전 봉 값을 함께 받고, 봉 마감 시각이 지났는지로 "마지막 완성봉"을 고른다.
// (lookahead+[1] 방식은 연장시간 차트의 애프터·프리마켓에서 한 봉 늦은 값을 보여 준다)
calcBoth() =>
    [k0, w0, c0] = calc()
    [k0, w0, c0, k0[1], w0[1], c0[1], k0[2], time_close]

tid   = regularOnly ? ticker.modify(syminfo.tickerid, session.regular) : syminfo.tickerid
tfUse = calcTf == "" ? timeframe.period : calcTf
[kC, wC, cC, kP, wP, cP, kPP, htfClose] = request.security(tid, tfUse, calcBoth(), lookahead = barmerge.lookahead_off)

bool  done  = na(htfClose) or timenow >= htfClose
float k     = done ? kC : kP
float w     = done ? wC : wP
float cz    = done ? cC : cP
float kPrev = done ? kP : kPP

zoneOf(float px) =>
    float d = w > 0 ? (px - k) / w : na
    na(d) ? na : d >= multB ? 2 : d >= multA ? 1 : d > -multA ? 0 : d > -multB ? -1 : -2

int zone     = zoneOf(cz)      // 마지막 완성봉 종가 기준 (판단용)
int liveZone = zoneOf(close)   // 지금 가격 기준 (참고용)

zoneName(int z) =>
    switch z
        2  => "과매수"
        1  => "매수"
        0  => "평범"
        -1 => "매도"
        -2 => "패닉셀"
        => "계산 중"

zoneAction(int z) =>
    switch z
        2  => "절반 익절"
        1  => "사도 좋음"
        0  => "보유 유지 · 신규 매수 안 함"
        -1 => "손절 (패닉 매수분은 평범 회복까지 보유)"
        -2 => "매수 기회"
        => ""

zoneColor(int z) =>
    switch z
        2  => cOver
        1  => cBuy
        0  => cMid
        -1 => cSell
        -2 => cPanic
        => color.gray

// ── 라인 ──────────────────────────────────────────────
float lOver  = k + multB * w
float lBuy   = k + multA * w
float lSell  = k - multA * w
float lPanic = k - multB * w

pOver  = plot(lOver,  "과매수 라인", cOver,  1, plot.style_stepline)
pBuy   = plot(lBuy,   "매수 라인",   cBuy,   1, plot.style_stepline)
pMid   = plot(k,      "평범 (칼만 중심선)", k >= kPrev ? cBuy : cSell, 2, plot.style_stepline)
pSell  = plot(lSell,  "매도 라인",   cSell,  1, plot.style_stepline)
pPanic = plot(lPanic, "패닉셀 라인", cPanic, 1, plot.style_stepline)
fill(pBuy,   pOver, showFill ? color.new(cBuy, 88)  : na, "매수 구간")
fill(pSell,  pBuy,  showFill ? color.new(cMid, 94)  : na, "평범 구간")
fill(pPanic, pSell, showFill ? color.new(cSell, 88) : na, "매도 구간")
barcolor(paintBars ? zoneColor(zone) : na)

// ── 구간 진입 표시와 알림 ─────────────────────────────
bool changed = not na(zone) and not na(zone[1]) and zone != zone[1]
plotshape(showMarks and changed and zone == 2,  "과매수 진입", shape.triangledown, location.abovebar, cOver,  text = "익절", size = size.tiny)
plotshape(showMarks and changed and zone == 1,  "매수 진입",   shape.triangleup,   location.belowbar, cBuy,   text = "매수", size = size.tiny)
plotshape(showMarks and changed and zone == -1, "매도 진입",   shape.triangledown, location.abovebar, cSell,  text = "손절", size = size.tiny)
plotshape(showMarks and changed and zone == -2, "패닉셀 진입", shape.triangleup,   location.belowbar, cPanic, text = "패닉", size = size.tiny)

alertcondition(changed and zone == 2,  "과매수 진입",   "{{ticker}} 과매수 구간 진입 - 절반 익절")
alertcondition(changed and zone == 1,  "매수 구간 진입", "{{ticker}} 매수 구간 진입 - 사도 좋음")
alertcondition(changed and zone == 0,  "평범 구간 진입", "{{ticker}} 평범 구간 진입 - 보유 유지")
alertcondition(changed and zone == -1, "매도 구간 진입", "{{ticker}} 매도 구간 진입 - 손절 검토")
alertcondition(changed and zone == -2, "패닉셀 진입",   "{{ticker}} 패닉셀 구간 진입 - 매수 기회")

fmt(float v) => str.tostring(v, format.mintick)
if changed
    alert(syminfo.ticker + " " + zoneName(zone[1]) + " → " + zoneName(zone) + " (" + zoneAction(zone) + ") | 과매수 " + fmt(lOver) + " / 매도 " + fmt(lSell) + " / 패닉셀 " + fmt(lPanic), alert.freq_once_per_bar)

// ── 표 ────────────────────────────────────────────────
var table tbl = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 15), border_width = 1)
if showTable and barstate.islast
    table.cell(tbl, 0, 0, "완성봉 구간 (" + tfUse + (regularOnly ? " 정규장)" : ")"), text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 0, zoneName(zone) + " · " + zoneAction(zone), text_color = zoneColor(zone), text_size = size.small)
    table.cell(tbl, 0, 1, "과매수 (익절 지정가)", text_color = cOver, text_size = size.small)
    table.cell(tbl, 1, 1, fmt(lOver), text_color = color.white, text_size = size.small)
    table.cell(tbl, 0, 2, "매수 라인", text_color = cBuy, text_size = size.small)
    table.cell(tbl, 1, 2, fmt(lBuy), text_color = color.white, text_size = size.small)
    table.cell(tbl, 0, 3, "평범 (칼만 중심선)", text_color = cMid, text_size = size.small)
    table.cell(tbl, 1, 3, fmt(k), text_color = color.white, text_size = size.small)
    table.cell(tbl, 0, 4, "매도 라인 (손절 기준)", text_color = cSell, text_size = size.small)
    table.cell(tbl, 1, 4, fmt(lSell), text_color = color.white, text_size = size.small)
    table.cell(tbl, 0, 5, "패닉셀 (매수 지정가)", text_color = cPanic, text_size = size.small)
    table.cell(tbl, 1, 5, fmt(lPanic), text_color = color.white, text_size = size.small)
    table.cell(tbl, 0, 6, "지금 가격 위치 (참고)", text_color = color.white, text_size = size.small)
    table.cell(tbl, 1, 6, zoneName(liveZone), text_color = zoneColor(liveZone), text_size = size.small)
    table.cell(tbl, 0, 7, "판단은 완성봉 구간으로", text_color = color.gray, text_size = size.tiny)
    table.cell(tbl, 1, 7, "라인은 봉 마감 때만 바뀜", text_color = color.gray, text_size = size.tiny)
